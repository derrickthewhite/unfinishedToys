		[while]
			[variable]
				less_than="$leaders_to_make_heroic.length"
				name="i"
			[/variable]
			[do]
				[set_variables]
					name="temp"
					[literal]
						[trait]
#textdomain wesnoth
							female_name=_"hero"
							id="heroicleader"
							male_name=_"hero"
							[effect]
								apply_to="attack"
								increase_damage=1
								range="melee"
							[/effect]
							[effect]
								apply_to="attack"
								increase_damage=1
								range="ranged"
							[/effect]
							[effect]
								apply_to="hitpoints"
								increase_total=5
							[/effect]
							[effect]
								apply_to="hitpoints"
								increase_total=1
								times="per level"
							[/effect]
							[effect]
								apply_to="movement"
								increase=1
							[/effect]
							[effect]
								apply_to="max_experience"
								increase="-20%"
							[/effect]
						[/trait]
					[/literal]
				[/set_variables]
				[set_variables]
					mode="append"
					name="leaders_to_make_heroic[$i].modifications.trait"
					[insert_tag]
						name="literal"
						variable="temp.trait"
					[/insert_tag]
				[/set_variables]
				[clear_variable]
					name="leaders_to_make_heroic[$i].max_moves,leaders_to_make_heroic[$i].moves,leaders_to_make_heroic[$i].max_hitpoints,leaders_to_make_heroic[$i].hitpoints,leaders_to_make_heroic[$i].attack,leaders_to_make_heroic[$i].max_experience"
				[/clear_variable]
				[unstore_unit]
					variable="leaders_to_make_heroic[$i]"
				[/unstore_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[clear_variable]
			name="leaders_to_make_heroic,temp"
		[/clear_variable]
	[/event]
