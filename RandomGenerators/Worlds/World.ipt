; World.ipt
; created 12/18/2015 12:13:15 PM
Use: ../Generators/Worlds/Magic.ipt
Use: ../Generators/Worlds/TechLevel.ipt
Use: ../Generators/Worlds/Cultures.ipt
Use: ../Generators/Worlds/StrangePeople.ipt 
Use: ../Generators/Worlds/Terrain.ipt


Table: RandomWorld
;Set: tl={1d11} 
Set: tl = [@LocusSkewTL]
;Set: numMagic = {min(1d10,1d10)-(round(tl/3)+1)}
[#{tl} TechLevel]<br>[#{1d20+tl} MagicList with {tl}]<br>[#{trim(tl)} CultureFromTech] [@StrangePeople] <br> [@CompletePlace]

Table: MagicList
Type: lookup
Set: tl = {$1}
Set: numMagic = {min(1d10,1d10)-(round(tl/3)+1)}
;Full set of magic
1-2:[!{1d3+1} MagicLimits >> implode] Magic (most magic)
;specific magic can happen
3-15:[@{numMagic} MagicWithLine]
;No magic exists
default:{''}  

Table: MagicWithLine
[@Magic]<br>

Table: LocusSkewTL
3:1
3:2
3:3
5:4
7:5
7:6
10:7
10:8
10:9
10:10
7:11

